  "normalization_rule": {
    "method": "strip_leading_and_trailing_whitespace",
    "description": "Deterministic whitespace normalization via str.strip(). Leading spaces in raw CIC-DDoS2019 column names (e.g., ' Source IP', ' Label') are stripped to canonical names ('Source IP', 'Label'). Original raw header strings and indices (0..87) are preserved for provenance. The original typo 'SimillarHTTP' is strictly preserved."
  },
  "feature_counts": {
    "source_columns": 88,
    "excluded_columns": 10,
    "included_features_o2": 78,
    "included_features_o3": 78
  },
  "shared_vector_decision": {
    "shared": true,
    "justification": "O2 (binary detection) and O3 (attack-type multi-class classification) share the exact same 78-feature flow vector. Both models characterize flow transport, packet length distributions, TCP flags, and inter-arrival times. Sharing the vector eliminates duplicate feature extraction pipelines and ensures identical zero-identity-leakage boundaries."
  },
  "leakage_controls": {
    "target_leakage": "Excluded ' Label' (target). Supervised targets (label_original, label_normalized, label_binary) strictly excluded.",
    "identity_leakage": "Excluded 'Flow ID', ' Source IP', ' Destination IP' to eliminate host/flow instance memorization.",
    "port_leakage": "Excluded ' Source Port' (ephemeral) and ' Destination Port' (service bias) to force models to learn flow dynamics rather than port mapping.",
    "temporal_leakage": "Excluded ' Timestamp' to prevent decision trees from partitioning capture dates/times.",
    "payload_sparsity": "Excluded 'SimillarHTTP' due to non-numeric type and high sparsity in non-HTTP attacks.",
    "topology_bias": "Excluded ' Inbound' testbed directional flag to eliminate synthetic topology bias.",
    "post_decision_leakage": "Forbidden prefixes strictly enforced: mitigation_, decision_, acceptance_, kpi_, latency_, result_."
  },
  "excluded_columns": [
    {
      "normalized_name": "Unnamed: 0",
      "raw_name": "Unnamed: 0",
      "source_index": 0,
      "sample_dtype": "int64",
      "exclusion_category": "INDEX_LEAKAGE",
      "rationale": "Arbitrary integer row index generated during CSV export. Has zero causal relationship to network traffic; if included, decision trees partition row offsets."
    },
    {
      "normalized_name": "Flow ID",
      "raw_name": "Flow ID",
      "source_index": 1,
      "sample_dtype": "str",
      "exclusion_category": "IDENTITY_LEAKAGE",
      "rationale": "Textual flow tuple identifier string combining IPs, ports, and timestamp. Memorizes specific connection instances rather than traffic dynamics."
    },
    {
      "normalized_name": "Source IP",
      "raw_name": " Source IP",
      "source_index": 2,
      "sample_dtype": "str",
      "exclusion_category": "IDENTITY_LEAKAGE",
      "rationale": "Host source IP address. Testbed IP addresses memorize specific simulated attackers/clients rather than generalizable attack traffic patterns."
    },
    {
      "normalized_name": "Source Port",
      "raw_name": " Source Port",
      "source_index": 3,
      "sample_dtype": "int64",
      "exclusion_category": "EPHEMERAL_PORT_LEAKAGE",
      "rationale": "Client or reflected source port. Highly dynamic/ephemeral or testbed-artifact specific; causes brittle port memorization."
    },
    {
      "normalized_name": "Destination IP",
      "raw_name": " Destination IP",
      "source_index": 4,
      "sample_dtype": "str",
      "exclusion_category": "IDENTITY_LEAKAGE",
      "rationale": "Victim host IP address. Memorizing static victim subnet addresses prevents generalization to any other protected network."
    },
    {
      "normalized_name": "Destination Port",
      "raw_name": " Destination Port",
      "source_index": 5,
      "sample_dtype": "int64",
      "exclusion_category": "SERVICE_PORT_BIAS",
      "rationale": "Destination service port. In CIC-DDoS2019, attack scripts targeted specific ports (e.g. 53, 123). Including destination port encourages models to predict attack types based purely on port numbers rather than flow volume and packet rate dynamics, causing severe false positives against legitimate services on the same port."
    },
    {
      "normalized_name": "Timestamp",
      "raw_name": " Timestamp",
      "source_index": 7,
      "sample_dtype": "str",
      "exclusion_category": "TEMPORAL_LEAKAGE",
      "rationale": "Capture wall-clock timestamp string. Attack campaigns occurred during discrete time windows on Jan 12 and Mar 11, 2019. Trees learn to partition capture dates/times directly."
    },
    {
      "normalized_name": "SimillarHTTP",
      "raw_name": "SimillarHTTP",
      "source_index": 85,
      "sample_dtype": "str",
      "exclusion_category": "PAYLOAD_METADATA_SPARSITY",
      "rationale": "Non-numeric string metadata field containing HTTP request snippets or '0'. Highly sparse, absent for UDP/ICMP/non-HTTP flows, and introduces text memorization. Excluded to ensure a uniform numeric flow feature space. Original spelling 'SimillarHTTP' is strictly preserved without modification."
    },
    {
      "normalized_name": "Inbound",
      "raw_name": " Inbound",
      "source_index": 86,
      "sample_dtype": "int64",
      "exclusion_category": "TOPOLOGY_LEAKAGE",
      "rationale": "Artificial binary direction flag assigned during testbed packet generation indicating flow toward victim subnet. In production perimeter monitoring, all ingress traffic is inbound, making this testbed-specific flag ungeneralizable."
    },
    {
      "normalized_name": "Label",
      "raw_name": " Label",
      "source_index": 87,
      "sample_dtype": "str",
      "exclusion_category": "TARGET_LEAKAGE",
      "rationale": "Supervised learning ground-truth target column. Preprocessed into label_original, label_normalized, and label_binary; strictly excluded from model feature inputs."
    }
  ],
