APP_NAME=CYBER-14 DDoS Detection and Mitigation
APP_ENV=development
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Secrets must be supplied through local environment variables.
# Do not commit real credentials.
SECRET_KEY=change-me-in-local-env

# Local authentication is disabled by default for existing development workflows.
AUTH_ENABLED=false
# Required only when AUTH_ENABLED=true. Use a local secret of at least 32 characters.
AUTH_SECRET_KEY=
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_BOOTSTRAP_USERNAME=admin
# Required only when AUTH_ENABLED=true; never commit a real password.
AUTH_BOOTSTRAP_PASSWORD=
AUTH_BOOTSTRAP_ROLE=admin
AUTH_LOGIN_MAX_ATTEMPTS_PER_MINUTE=10

# Model artifact paths and fixture configuration
O2_MODEL_PATH=
O3_MODEL_PATH=
O2_FIXTURE_ONLY=false
O3_FIXTURE_ONLY=false

# Controlled traffic streaming and WebSocket limits
STREAM_SIMULATOR_ENABLED=false
WEBSOCKET_MAX_MESSAGE_BYTES=16384
WEBSOCKET_MAX_MESSAGES_PER_SECOND=10
WEBSOCKET_IDLE_TIMEOUT_SECONDS=60
