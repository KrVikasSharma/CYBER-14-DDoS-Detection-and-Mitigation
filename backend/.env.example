# CYBER-14 Environment Configuration Example
# Copy to .env for local development. Never commit real .env files containing secrets.

DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/cyber14_ddos
AUTH_ENABLED=true
AUTH_SECRET_KEY=presentation-secret-key-32-chars-long!
AUTH_BOOTSTRAP_PASSWORD=DemoAdminPassword123!
DEMO_MODE=true
STREAM_SIMULATOR_ENABLED=true
